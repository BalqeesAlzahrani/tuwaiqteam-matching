rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Members collection: Public directory for Tuwaiq Club
    match /members/{memberId} {
      // 1. All visitors & members can read member profiles to discover teammates
      allow read: if true;

      // 2. Authenticated user can create their own profile
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id == memberId
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;

      // 3. Authenticated user can only update their own profile; cannot modify others
      allow update: if isAuthenticated()
                    && request.resource.data.id == memberId
                    && request.resource.data.ownerUid == request.auth.uid
                    && (
                      // Profile owner matching authenticated UID
                      resource.data.ownerUid == request.auth.uid
                      ||
                      // Legacy profile claim via verified matching email if ownerUid wasn't set
                      (resource.data.ownerUid == null && resource.data.contact.email != null && request.auth.token.email != null && resource.data.contact.email == request.auth.token.email)
                    );

      // 4. Authenticated user can only delete their own profile
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.id == teamId
                    && request.resource.data.name is string;
      allow update: if isAuthenticated() && request.resource.data.id == teamId;
      allow delete: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || resource.data.creatorId == null);
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.resource.data.id == invitationId;
      allow delete: if isAuthenticated();
    }

    // Bookmarks collection (keyed by userId)
    match /bookmarks/{userId} {
      allow read, write: if true;
    }
  }
}

