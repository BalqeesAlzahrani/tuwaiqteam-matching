{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TuwaiqTeamMatch Firestore Blueprint",
  "description": "Schema definitions for Tuwaiq Team Match platform Firestore collections",
  "entities": {
    "members": {
      "title": "Members",
      "description": "Student profiles with skills, interests, and contact information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "major": { "type": "string" },
        "majorAr": { "type": "string" },
        "academicYear": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "skillCategories": { "type": "array", "items": { "type": "string" } },
        "interests": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "string" },
        "canHelpWith": { "type": "string" },
        "lookingFor": { "type": "string" },
        "competitionInterests": { "type": "array", "items": { "type": "string" } },
        "contact": { "type": "object" },
        "isAvailableForTeam": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerKey": { "type": "string" }
      },
      "required": ["id", "name", "major", "academicYear", "skills", "createdAt"]
    },
    "teams": {
      "title": "Teams",
      "description": "Student project and hackathon teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "competition": { "type": "string" },
        "description": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorUid": { "type": "string" },
        "members": { "type": "array" },
        "maxMembers": { "type": "number" },
        "requiredSkills": { "type": "array", "items": { "type": "string" } },
        "balanceScore": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "creatorId", "members", "createdAt"]
    },
    "invitations": {
      "title": "Invitations",
      "description": "Team invitations sent between students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderUid": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverUid": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "roleProposed": { "type": "string" },
        "status": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "teamId", "senderId", "receiverId", "status", "createdAt"]
    },
    "bookmarks": {
      "title": "Bookmarks",
      "description": "Saved member profiles per user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "savedMemberIds": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "savedMemberIds"]
    }
  }
}
